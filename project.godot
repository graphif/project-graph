config_version=5

[application]

config/name="Project Graph"
config/description="Visual workspace for connected ideas"
config/version="0.1.21"
run/main_scene="res://src/boot/boot.tscn"
config/features=PackedStringArray("4.8", "GL Compatibility")
boot_splash/bg_color=Color(0.09411765, 0.09411765, 0.14509805, 1)
boot_splash/show_image=false
config/icon="res://project-graph-icon.svg"
boot_splash/minimum_display_time=0.0

[autoload]

MCPRuntimeProbe="*res://addons/godot_mcp/runtime/mcp_runtime_probe.gd"

[display]

window/size/borderless=true
window/stretch/mode="canvas_items"
window/per_pixel_transparency/allowed=true
display_server/driver.linuxbsd="wayland"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[gui]

theme/custom_font="res://assets/fonts/PingFang-SC-Regular.ttf"

