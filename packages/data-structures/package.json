{
  "name": "@graphif/data-structures",
  "description": "Serializable data structures",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "module": "dist/index.mjs",
    "types": "dist/index.d.mts",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "type-check": "tsc",
    "publish": "pnpm publish --no-git-checks"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@graphif/serializer": "workspace:*",
    "unplugin-original-class-name": "catalog:"
  }
}
