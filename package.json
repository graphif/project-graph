{
  "name": "project-graph",
  "version": "0.0.0",
  "description": "An open-source project that aims to provide a next-generation node diagram tool for visual thinking.",
  "type": "module",
  "engines": {
    "node": ">=26.0.0",
    "bun": "1.4.4"
  },
  "workspaces": {
    "packages": [
      "app",
      "packages/*"
    ],
    "catalog": {
      "react": "^19.1.0",
      "@types/react": "^19.2.14",
      "react-dom": "^19.1.0",
      "typescript": "5.9.2",
      "tsdown": "^0.21.10",
      "jotai": "^2.12.5",
      "vitest": "4.1.5",
      "unplugin-original-class-name": "^1.0.1"
    }
  },
  "trustedDependencies": [
    "bcrypt",
    "core-js",
    "esbuild",
    "nx",
    "sharp"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "dev": "bun run --cwd app dev",
    "build": "nx run @graphif/project-graph:build:desktop",
    "build:ci": "nx run @graphif/project-graph:build:desktop --skipNxCache",
    "build:packages": "nx run-many -t build --exclude @graphif/project-graph",
    "prepare": "husky",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "cli": "node ./packages/project-graph-cli/src/cli.mjs",
    "benchmark:cli:cold-start": "bun run --cwd app ./src/cli/ProjectGraphCliBenchmark.ts",
    "test:cli:desktop": "bun run --cwd app ./src/cli/ProjectGraphCliDesktopAcceptance.ts",
    "format": "prettier --write .",
    "test": "vitest run --exclude app/src/cli/ProjectGraphCliProduction.test.ts && vitest run app/src/cli/ProjectGraphCliProduction.test.ts",
    "prepublish": "bun run build:packages",
    "publish": "nx run-many -t release"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.2",
    "@graphif/project-graph-cli": "workspace:*",
    "cross-env": "^10.1.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "nx": "24.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.59.1",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.4.4"
}
