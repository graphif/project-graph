[
  {
    "name": "get_all_nodes",
    "description": "获取舞台上所有对象及其项目级引用",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "delete_node",
    "description": "根据项目级引用删除节点及其关联连线",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^n[1-9]\\d*$",
          "description": "当前项目中的节点引用，例如n1"
        }
      },
      "required": ["ref"],
      "additionalProperties": false
    }
  },
  {
    "name": "delete_nodes",
    "description": "批量删除指定项目级引用对应的节点及其关联连线",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^n[1-9]\\d*$",
            "description": "当前项目中的节点引用，例如n1"
          },
          "description": "要删除的节点引用数组"
        }
      },
      "required": ["refs"],
      "additionalProperties": false
    }
  },
  {
    "name": "delete_selected_nodes",
    "description": "删除当前所有选中的节点",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "delete_all_nodes",
    "description": "删除舞台上所有的节点和连线（清空舞台）",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "edit_text_node",
    "description": "编辑 TextNode 的内容、颜色和尺寸。此工具不会移动节点。",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^n[1-9]\\d*$",
          "description": "当前项目中的节点引用，例如n1"
        },
        "data": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "color": {
              "description": "[255,255,255,1]",
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "width": {
              "type": "number",
              "minimum": 16,
              "maximum": 4096
            },
            "sizeAdjust": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "auto",
                  "description": "自动调整宽度"
                },
                {
                  "type": "string",
                  "const": "manual",
                  "description": "宽度由width字段定义，文本自动换行"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["ref", "data"],
      "additionalProperties": false
    }
  },
  {
    "name": "edit_image_node",
    "description": "编辑 ImageNode 的显示尺寸和背景状态。图片始终保持原始宽高比；此工具不会移动节点。",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^n[1-9]\\d*$",
          "description": "当前项目中的节点引用，例如n1"
        },
        "data": {
          "type": "object",
          "properties": {
            "displaySize": {
              "type": "object",
              "properties": {
                "basis": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "width"
                    },
                    {
                      "type": "string",
                      "const": "height"
                    },
                    {
                      "type": "string",
                      "const": "longest_edge"
                    }
                  ],
                  "description": "按照宽度、高度或最长边设置显示尺寸"
                },
                "value": {
                  "type": "number",
                  "minimum": 16,
                  "maximum": 4096,
                  "description": "目标显示尺寸"
                }
              },
              "required": ["basis", "value"],
              "additionalProperties": false
            },
            "isBackground": {
              "description": "是否把图片作为背景图片",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["ref", "data"],
      "additionalProperties": false
    }
  },
  {
    "name": "auto_layout_dag",
    "description": "将同一分组层级中已经通过有向连线连接的普通节点，按从左到右的 DAG 分层方式整体布局。创建并连线完成后调用一次；不能用于 Section、孤立节点或有环图。",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "refs": {
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^n[1-9]\\d*$",
            "description": "当前项目中的节点引用，例如n1"
          },
          "description": "需要整体布局的节点项目级引用"
        }
      },
      "required": ["refs"],
      "additionalProperties": false
    }
  },
  {
    "name": "create_text_node",
    "description": "创建 TextNode。节点会插入到当前视野中心；完成连线后使用 auto_layout_dag 整体整理，不要尝试提供坐标。",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "color": {
          "description": "[R,G,B,A]，不填写时使用透明色",
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "width": {
          "description": "手动宽度模式下的文本框宽度",
          "type": "number",
          "minimum": 16,
          "maximum": 4096
        },
        "sizeAdjust": {
          "anyOf": [
            {
              "type": "string",
              "const": "auto",
              "description": "自动调整宽度"
            },
            {
              "type": "string",
              "const": "manual",
              "description": "宽度由width字段定义，文本自动换行"
            }
          ]
        }
      },
      "required": ["text"],
      "additionalProperties": false
    }
  },
  {
    "name": "generate_node_tree_by_text",
    "description": "根据纯文本缩进结构生成树状节点",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "包含缩进结构的文本，每一层缩进2个空格，例如：'root\\n  child1\\n  child2\\n    grandchild'"
        }
      },
      "required": ["text"],
      "additionalProperties": false
    }
  },
  {
    "name": "expand_node_tree_from_node",
    "description": "从指定节点开始进行树形扩展，传入一个节点引用和缩进文本，在该节点下生成树状子节点",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^n[1-9]\\d*$",
          "description": "根节点引用"
        },
        "text": {
          "type": "string",
          "description": "包含缩进结构的文本，每一层缩进2个空格，例如：'child1\\n  grandchild\\nchild2'"
        }
      },
      "required": ["ref", "text"],
      "additionalProperties": false
    }
  },
  {
    "name": "search_text_nodes_by_regex",
    "description": "根据正则表达式搜索文本节点",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "regex": {
          "type": "string",
          "description": "正则表达式字符串"
        }
      },
      "required": ["regex"],
      "additionalProperties": false
    }
  },
  {
    "name": "get_children",
    "description": "通过项目级引用获取一个节点的所有第一层子节点（基于连接关系）",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^n[1-9]\\d*$",
          "description": "当前项目中的节点引用，例如n1"
        }
      },
      "required": ["ref"],
      "additionalProperties": false
    }
  },
  {
    "name": "get_parents",
    "description": "通过项目级引用获取一个节点的所有父级节点（基于连接关系）",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^n[1-9]\\d*$",
          "description": "当前项目中的节点引用，例如n1"
        }
      },
      "required": ["ref"],
      "additionalProperties": false
    }
  },
  {
    "name": "batch_change_color",
    "description": "批量给物体更改颜色",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:n|e)[1-9]\\d*$",
            "description": "当前项目中的对象引用，例如n1或e1"
          },
          "description": "对象引用数组"
        },
        "color": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "description": "[R,G,B,A]，RGB为0~255，A为0~1"
        }
      },
      "required": ["refs", "color"],
      "additionalProperties": false
    }
  },
  {
    "name": "get_object_details",
    "description": "通过项目级引用数组获取对象的模型可读详细信息",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:n|e)[1-9]\\d*$",
            "description": "当前项目中的对象引用，例如n1或e1"
          },
          "description": "对象引用数组"
        }
      },
      "required": ["refs"],
      "additionalProperties": false
    }
  },
  {
    "name": "check_connections",
    "description": "检查节点是否是通过Edge直接连接的",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "pairs": {
          "type": "array",
          "items": {
            "minItems": 2,
            "maxItems": 2,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^n[1-9]\\d*$",
              "description": "当前项目中的节点引用，例如n1"
            }
          },
          "description": "节点引用对数组，例如[[n1,n2],[n3,n4]]"
        }
      },
      "required": ["pairs"],
      "additionalProperties": false
    }
  },
  {
    "name": "create_edges",
    "description": "创建一些连线连接多个物体",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceRef": {
                "type": "string",
                "pattern": "^n[1-9]\\d*$",
                "description": "当前项目中的节点引用，例如n1"
              },
              "targetRef": {
                "type": "string",
                "pattern": "^n[1-9]\\d*$",
                "description": "当前项目中的节点引用，例如n1"
              },
              "text": {
                "default": "",
                "type": "string"
              }
            },
            "required": ["sourceRef", "targetRef", "text"],
            "additionalProperties": false
          }
        }
      },
      "required": ["edges"],
      "additionalProperties": false
    }
  },
  {
    "name": "change_edge_text",
    "description": "更改连线上的文字",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "edgeRef": {
          "type": "string",
          "pattern": "^e[1-9]\\d*$",
          "description": "当前项目中的连线引用，例如e1"
        },
        "text": {
          "type": "string"
        }
      },
      "required": ["edgeRef", "text"],
      "additionalProperties": false
    }
  },
  {
    "name": "select_objects",
    "description": "通过项目级引用选中一些舞台对象",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:n|e)[1-9]\\d*$",
            "description": "当前项目中的对象引用，例如n1或e1"
          },
          "description": "要选中的对象引用数组"
        },
        "clearOthers": {
          "default": false,
          "description": "是否清除其他对象的选中状态",
          "type": "boolean"
        }
      },
      "required": ["refs", "clearOthers"],
      "additionalProperties": false
    }
  },
  {
    "name": "get_selected_nodes",
    "description": "获取用户当前所有选中对象的详细信息和项目级引用",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "get_nodes_in_viewport",
    "description": "获取当前视野范围中被完全覆盖住的节点",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "get_selected_refs",
    "description": "获取用户当前所有选中对象的项目级引用",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "breadth_expand_node",
    "description": "广度扩展一个节点，传入一个节点引用和字符串数组，自动添加一层子节点",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^n[1-9]\\d*$",
          "description": "源节点引用"
        },
        "texts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "要添加的子节点文本数组"
        }
      },
      "required": ["ref", "texts"],
      "additionalProperties": false
    }
  },
  {
    "name": "depth_expand_node",
    "description": "深度扩展一个节点，传入一个节点引用作为根节点，根据字符串数组扩展出链式结构",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^n[1-9]\\d*$",
          "description": "根节点引用"
        },
        "texts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "要添加的链式节点文本数组"
        }
      },
      "required": ["ref", "texts"],
      "additionalProperties": false
    }
  },
  {
    "name": "sort_selected_nodes_by_y",
    "description": "对选中的所有文本节点按照从上到下的顺序重新排列位置（y轴方向）。AI调用前需先用get_selected_nodes获取当前选中节点信息，按y坐标从小到大排列得到current_order，再根据用户期望得到desired_order。",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "current_order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "当前选中文本节点的文本内容数组，按y坐标从上到下（从小到大）排列"
        },
        "desired_order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "期望排列的文本内容顺序数组，从上到下，必须与current_order包含完全相同的元素"
        }
      },
      "required": ["current_order", "desired_order"],
      "additionalProperties": false
    }
  },
  {
    "name": "sort_selected_nodes_by_x",
    "description": "对选中的所有文本节点按照从左到右的顺序重新排列位置（x轴方向）。AI调用前需先用get_selected_nodes获取当前选中节点信息，按x坐标从小到大排列得到current_order，再根据用户期望得到desired_order。",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "current_order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "当前选中文本节点的文本内容数组，按x坐标从左到右（从小到大）排列"
        },
        "desired_order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "期望排列的文本内容顺序数组，从左到右，必须与current_order包含完全相同的元素"
        }
      },
      "required": ["current_order", "desired_order"],
      "additionalProperties": false
    }
  },
  {
    "name": "search_and_add_image_node",
    "description": "从 Openverse 搜索开放授权的网络图片，下载后在当前视野中心创建 ImageNode。完成连线后使用 auto_layout_dag 整体整理；工具不返回图片 URL、附件 ID 或坐标。",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400,
          "description": "图片搜索关键词，建议包含主体、场景和风格"
        },
        "preferredOrientation": {
          "description": "偏好的图片方向，不填写时使用搜索相关度最高的结果",
          "anyOf": [
            {
              "type": "string",
              "const": "square"
            },
            {
              "type": "string",
              "const": "landscape"
            },
            {
              "type": "string",
              "const": "portrait"
            }
          ]
        },
        "maxDisplaySize": {
          "description": "图片节点最长边的最大画布显示尺寸，默认480",
          "type": "number",
          "minimum": 128,
          "maximum": 1600
        }
      },
      "required": ["query"],
      "additionalProperties": false
    }
  },
  {
    "name": "get_image_file",
    "description": "将指定节点中的图片导出到应用缓存目录，并返回外部 Agent 可读取的本地文件路径。传入ImageNode引用或包含图片的Section引用。",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^n[1-9]\\d*$",
          "description": "ImageNode引用，或包含图片的Section引用"
        }
      },
      "required": ["ref"],
      "additionalProperties": false
    }
  }
]
