{
  "name": "@graphif/project-graph",
  "targets": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true,
      "outputs": ["{projectRoot}/dist/**"]
    },
    "dev": {
      "cache": false,
      "continuous": true
    },
    "type-check": {
      "cache": true,
      "inputs": ["{projectRoot}/src/**/*.{ts,tsx}"]
    },
    "build:desktop": {
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "{projectRoot}/**/*.go",
        "{projectRoot}/go.mod",
        "{projectRoot}/go.sum",
        "{projectRoot}/mygo.config.ts",
        "{projectRoot}/resources/**/*"
      ],
      "outputs": ["{projectRoot}/build/**"],
      "cache": false
    },
    "sync-locales": {
      "cache": false
    }
  }
}
